# CLIPLAB — copie para .env (nunca commitar secrets)

# --- CORE ---
NODE_ENV=development
# --- APP ---
# URL pública usada em links de e-mail e redirecionamentos.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Base HTTPS pública para APIs externas (Meta etc.). Vazio = AUTH_URL. Nunca localhost em produção.
MEDIA_BASE_URL=
LOG_LEVEL=info
# true só se o processo web deve também rodar workers (dev). Produção: false + npm run worker.
CLIPLAB_EMBED_WORKERS=
# Origens extras CORS (separadas por vírgula). Autenticado nunca usa *.
CORS_ORIGINS=

# --- DATABASE ---
# PostgreSQL. Essencial. Sem isto o app não fica ready.
DATABASE_URL=postgresql://cliplab:cliplab@localhost:5432/cliplab

# --- AUTH ---
# Segredo de sessão Auth.js. Gerado automaticamente no .env local se ausente.
AUTH_SECRET=
# Login Google opcional (também reutilizado pelo YouTube se GOOGLE_* vazio).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- ENCRYPTION ---
# Chave para tokens OAuth em repouso. Gerada automaticamente no .env local se ausente.
ENCRYPTION_KEY=

# --- STORAGE ---
# local | s3 | r2 | b2 — desenvolvimento pode ser local.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Teto global de upload (bytes). O limite efetivo é min(isto, limite do plano).
MAX_VIDEO_UPLOAD_BYTES=

# --- REDIS ---
# Produção: obrigatório para TODAS as filas (sem fallback em memória). Dev: vazio = LOCAL FALLBACK in-process.
REDIS_URL=

# Concurrency do worker (FFmpeg/OpenAI). Padrão 1.
WORKER_CONCURRENCY=1

# --- OPENAI ---
# Sem chave: transcrição/análise MOCK explícito em desenvolvimento. Produção exige a chave quando o AI estiver ligado.
# Com chave: pipeline REAL (whisper-1 com timestamps + análise estruturada). Somente servidor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Produção: omitir ou false até o primeiro teste real (default false quando NODE_ENV=production).
# true libera Whisper/análise OpenAI. Dev/test: omitir = true. false sempre bloqueia HTTP OpenAI.
ALLOW_EXTERNAL_AI_PROCESSING=
# Produção: omitir ou false (default false quando NODE_ENV=production).
# Mesmo com contas conectadas, recovery/smoke não publica. true só após decisão explícita.
# Dev/test: omitir = true. false sempre bloqueia publicação real.
ALLOW_SOCIAL_PUBLISH=

# --- SOCIAL (padrão: Upload-Post white-label) ---
# upload-post | native | mock
SOCIAL_PROVIDER=upload-post
# Somente servidor. Nunca NEXT_PUBLIC / frontend.
UPLOAD_POST_API_KEY=
# Opcional. Padrão https://api.upload-post.com/api
UPLOAD_POST_API_BASE=
# Opcional. HMAC dos webhooks (X-Upload-Post-Signature).
UPLOAD_POST_WEBHOOK_SECRET=

# --- OPTIONAL NATIVE SOCIAL PROVIDERS ---
# Só necessários se SOCIAL_PROVIDER=native (fallback legado).
# --- TIKTOK ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Opcional; padrão = AUTH_URL + /api/social/oauth/callback
TIKTOK_REDIRECT_URI=
# true somente após audit Content Posting / video.publish
TIKTOK_CONTENT_POSTING_APPROVED=
# Fallback legado. Prefira TIKTOK_CLIENT_KEY.
# TIKTOK_CLIENT_ID=

# --- META (Instagram + Facebook) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_VERSION=v26.0
# HTTPS público que a Meta consegue baixar. Não use localhost.
META_MEDIA_BASE_URL=
META_INSTAGRAM_PUBLISH_APPROVED=
META_FACEBOOK_PUBLISH_APPROVED=
META_INSIGHTS_APPROVED=
META_WEBHOOK_VERIFY_TOKEN=

# --- X ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
# free | basic | pro | enterprise — publicação exige Basic+ (ou X_WRITE_ACCESS_APPROVED)
X_API_TIER=
X_WRITE_ACCESS_APPROVED=
X_LONG_POSTS=

# --- GOOGLE / YOUTUBE ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Fallbacks se GOOGLE_* / AUTH_GOOGLE_* já existirem: não duplique.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=
YOUTUBE_UPLOAD_APPROVED=
YOUTUBE_ANALYTICS_APPROVED=
YOUTUBE_ANALYTICS_SCOPE=

# --- STRIPE (TEST MODE ONLY) ---
# Nunca use chaves sk_live_ / pk_live_ neste ambiente.
# Deixe vazio até ter valores reais de teste. Não invente placeholders.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_BUSINESS=
# Checkout liga automaticamente quando as chaves TEST e os Price IDs estiverem completos.
# Webhook local: o Dashboard Stripe não aceita http://localhost. Instale Stripe CLI e rode:
# stripe listen --forward-to http://localhost:3000/api/webhooks/stripe
# Use o whsec_ impresso pelo CLI em STRIPE_WEBHOOK_SECRET. Eventos: checkout.session.completed,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
# invoice.paid, invoice.payment_failed.

# --- IDENTITY (opcional) ---
# Se definido, atualiza o nome de exibição do owner atual (mesmo user id). Não invente um nome aqui.
# CLIPLAB_OWNER_NAME=

# --- SMTP ---
# EMAIL_PROVIDER=smtp
# Sem SMTP_HOST + SMTP_FROM + SMTP_USER + SMTP_PASSWORD o app NÃO finge envio.
# Estado: EMAIL: CONFIGURATION REQUIRED. E-mails ficam na outbox até as credenciais existirem.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CLIPLAB

# --- LOCAL OWNER (opcional, só desenvolvimento) ---
# Nunca auto-login. Nunca usar em produção. Não coloque a senha no código.
# npm run auth:dev-owner
# DEV_OWNER_EMAIL=
# DEV_OWNER_PASSWORD=

# --- OBSERVABILITY ---
SENTRY_DSN=

# --- FFMPEG ---
FFMPEG_TIMEOUT_MS=600000
FFMPEG_MAX_CONCURRENCY=1
FFMPEG_MAX_DURATION_SEC=14400

# Dev: adapters OAuth de desenvolvimento para redes sem credencial oficial.
DEV_MOCK_PROVIDERS=true

# Dados seed/demo na UI. Default false. Nunca ligar em produção.
ENABLE_DEMO_DATA=false
