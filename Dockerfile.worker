# syntax=docker/dockerfile:1
# Railway worker service: set Dockerfile path to /Dockerfile.worker
# Does not start Next.js. Web image remains Dockerfile (default stage web).

FROM node:22-bookworm AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

FROM node:22-bookworm AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npx prisma generate && node scripts/build-worker.mjs

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV CLIPLAB_EMBED_WORKERS=false
COPY package.json package-lock.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci --omit=dev --ignore-scripts
COPY --from=build /app/generated ./generated
COPY --from=build /app/dist/worker.mjs ./dist/worker.mjs
COPY --from=build /app/scripts/start-worker.mjs ./scripts/start-worker.mjs
CMD ["node", "scripts/start-worker.mjs"]
